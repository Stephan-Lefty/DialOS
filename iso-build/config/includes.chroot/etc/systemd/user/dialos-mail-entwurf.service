[Unit]
# Traegt beim Anmelden Mail-Entwuerfe in Thunderbird ein, die beim Antworten
# vorgemerkt wurden, weil Thunderbird gerade lief (2026-09-18).
#
# SEIT DEM 2026-09-21 IST DAS NUR NOCH DAS NETZ UNTER DEM NETZ. Nachgeholt
# wird jetzt dort, wo es hingehoert: Die Bruecke (dialos-thunderbird-bruecke.py)
# arbeitet die Warteschlange ab, sobald Thunderbird sie startet - dann ist
# Thunderbird naemlich da und legt den Entwurf selbst im Konto-Ordner ab.
#
# Warum der Dienst trotzdem bleibt: Laeuft Thunderbird beim Anmelden bereits
# (Autostart), findet er hier eine Warteschlange, die sonst bis zum naechsten
# Thunderbird-Start liegenbliebe. Ist Thunderbird zu oder die Schlange leer,
# tut er nichts - er kann also nicht schaden.
Description=DialOS: vorgemerkte Mail-Entwuerfe in Thunderbird
Documentation=file:///usr/local/bin/dialos-mail-entwurf.py
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dialos-mail-entwurf.py nachholen
Nice=15

[Install]
WantedBy=default.target
