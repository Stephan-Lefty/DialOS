Window.SetBackgroundTopColor(0.02, 0.03, 0.06);
Window.SetBackgroundBottomColor(0.02, 0.03, 0.06);

bg.image = Image("background.png").Scale(Window.GetWidth(), Window.GetHeight());
bg.sprite = Sprite(bg.image);
bg.sprite.SetX(0);
bg.sprite.SetY(0);
bg.sprite.SetZ(-10);

bar.width = 260;
bar.height = 6;
bar.x = Window.GetWidth() / 2 - bar.width / 2;
bar.y = Window.GetHeight() - 90;

bar.track = Rectangle(bar.width, bar.height, 1, 1, 1);
bar.track.sprite = Sprite(bar.track);
bar.track.sprite.SetX(bar.x);
bar.track.sprite.SetY(bar.y);
bar.track.sprite.SetOpacity(0.25);

bar.fill = Rectangle(1, bar.height, 0.15, 0.4, 0.55);
bar.fill.sprite = Sprite(bar.fill);
bar.fill.sprite.SetX(bar.x);
bar.fill.sprite.SetY(bar.y);

fun progress_callback(duration, progress) {
  bar.fill = Rectangle(Math.Max(1, bar.width * progress), bar.height, 0.15, 0.4, 0.55);
  bar.fill.sprite.SetImage(bar.fill);
}
Plymouth.SetBootProgressFunction(progress_callback);
