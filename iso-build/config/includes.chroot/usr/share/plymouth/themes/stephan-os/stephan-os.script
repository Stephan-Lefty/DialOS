Window.SetBackgroundTopColor(1, 1, 1);
Window.SetBackgroundBottomColor(1, 1, 1);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

bar.width = 220;
bar.height = 6;
bar.x = Window.GetWidth() / 2 - bar.width / 2;
bar.y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;

bar.track = Rectangle(bar.width, bar.height, 0.85, 0.85, 0.85);
bar.track.sprite = Sprite(bar.track);
bar.track.sprite.SetX(bar.x);
bar.track.sprite.SetY(bar.y);

bar.fill = Rectangle(1, bar.height, 0.15, 0.4, 0.55);
bar.fill.sprite = Sprite(bar.fill);
bar.fill.sprite.SetX(bar.x);
bar.fill.sprite.SetY(bar.y);

fun refresh_callback() {
  time = Plymouth.GetTime();
  logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(time * 2));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  bar.fill = Rectangle(Math.Max(1, bar.width * progress), bar.height, 0.15, 0.4, 0.55);
  bar.fill.sprite.SetImage(bar.fill);
}
Plymouth.SetBootProgressFunction(progress_callback);
