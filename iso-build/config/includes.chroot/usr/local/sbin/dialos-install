#!/bin/bash
# DialOS installer: writes the running live system to an internal
# disk, encrypted with LUKS and unlocked via a keyfile on a dedicated
# USB stick instead of a typed passphrase (see
# docs/sicherheit-datenschutz.md). Meant to be run once per device by
# Stephan during office setup - NOT part of the voice-guided on-site
# setup, so it is deliberately a plain graphical/terminal tool, not
# accessible-by-voice.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  exec pkexec "$0" "$@"
fi

LABEL="DIALOS-KEY"
KEYFILE_NAME=".dialos-key"
TARGET_MNT="/mnt/dialos-install"
LUKS_NAME="dialos-root"

say() { zenity --info --width=400 --title="DialOS Installation" --text="$1" 2>/dev/null || echo "$1"; }
warn() { zenity --warning --width=400 --title="DialOS Installation" --text="$1" 2>/dev/null || echo "$1" >&2; }
die() { zenity --error --width=400 --title="DialOS Installation" --text="$1" 2>/dev/null || echo "$1" >&2; exit 1; }
ask_password() { zenity --password --title="$1" 2>/dev/null; }

LIVE_ROOT_SRC=$(findmnt -no SOURCE / || true)
LIVE_ROOT_DISK=""
if [ -n "$LIVE_ROOT_SRC" ]; then
  LIVE_ROOT_DISK=$(lsblk -no PKNAME "$LIVE_ROOT_SRC" 2>/dev/null || true)
fi

echo "== DialOS Installer =="

# --- 1. Select target disk (internal, not the live boot medium) ---
mapfile -t DISK_ROWS < <(lsblk -dnb -o NAME,SIZE,MODEL,TRAN | awk -v skip="$LIVE_ROOT_DISK" '$1 != skip')
DISK_ARGS=()
for row in "${DISK_ROWS[@]}"; do
  name=$(echo "$row" | awk '{print $1}')
  size=$(echo "$row" | awk '{print $2}')
  model=$(echo "$row" | cut -d' ' -f3- | sed 's/ *[0-9]*$//')
  sizeh=$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")
  DISK_ARGS+=("/dev/$name" "$sizeh $model")
done

if [ "${#DISK_ARGS[@]}" -eq 0 ]; then
  die "Keine passende Zielfestplatte gefunden."
fi

TARGET_DISK=$(zenity --list --title="Zielfestplatte wählen" \
  --text="ACHTUNG: Die gewählte Festplatte wird VOLLSTÄNDIG gelöscht.\nDas aktuelle Boot-Medium ist ausgeblendet." \
  --column="Gerät" --column="Größe / Modell" --width=600 --height=300 \
  "${DISK_ARGS[@]}")
[ -n "$TARGET_DISK" ] || die "Abgebrochen: keine Festplatte gewählt."

# --- 2. Select the USB stick that will hold the LUKS keyfile ---
mapfile -t USB_ROWS < <(lsblk -dnb -o NAME,SIZE,TRAN | awk '$3=="usb"')
USB_ARGS=()
for row in "${USB_ROWS[@]}"; do
  name=$(echo "$row" | awk '{print $1}')
  size=$(echo "$row" | awk '{print $2}')
  sizeh=$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")
  USB_ARGS+=("/dev/$name" "$sizeh")
done

if [ "${#USB_ARGS[@]}" -eq 0 ]; then
  die "Kein USB-Stick gefunden. Sicherheits-Stick anschließen und erneut versuchen."
fi

KEY_STICK=$(zenity --list --title="Sicherheits-Stick wählen" \
  --text="Auf diesem Stick wird der Entschlüsselungs-Schlüssel gespeichert.\nDer Stick wird dabei neu formatiert." \
  --column="Gerät" --column="Größe" --width=500 --height=250 \
  "${USB_ARGS[@]}")
[ -n "$KEY_STICK" ] || die "Abgebrochen: kein Sicherheits-Stick gewählt."

# --- 3. Recovery passphrase (temporary policy until docs/offene-punkte.md is resolved) ---
say "Zusätzlich zum Stick wird ein Wiederherstellungs-Passwort als zweiter LUKS-Schlüssel angelegt (Notfall, falls der Stick verloren geht). Bitte sicher verwahren, NICHT dem Endnutzer geben. Mindestens 12 Zeichen."
RECOVERY_PASS=""
while [ -z "$RECOVERY_PASS" ] || [ "${#RECOVERY_PASS}" -lt 12 ]; do
  RECOVERY_PASS=$(ask_password "Wiederherstellungs-Passwort festlegen (mind. 12 Zeichen)")
  if [ -z "$RECOVERY_PASS" ]; then
    warn "Passwort darf nicht leer sein."
  elif [ "${#RECOVERY_PASS}" -lt 12 ]; then
    warn "Passwort ist zu kurz (mind. 12 Zeichen)."
    RECOVERY_PASS=""
  fi
done

# --- 4. Final confirmation ---
CONFIRM=$(zenity --entry --title="Letzte Bestätigung" \
  --text="Zielfestplatte $TARGET_DISK und Stick $KEY_STICK werden GELÖSCHT.\nZum Bestätigen \"LOESCHEN\" eingeben:" 2>/dev/null || true)
[ "$CONFIRM" = "LOESCHEN" ] || die "Abgebrochen: Bestätigung nicht erhalten."

echo "Installiere auf $TARGET_DISK, Schlüssel-Stick $KEY_STICK ..."

# --- 5. Partition target disk: ESP + LUKS ---
umount "${TARGET_DISK}"* 2>/dev/null || true
wipefs -af "$TARGET_DISK"
parted -s "$TARGET_DISK" mklabel gpt
parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 513MiB
parted -s "$TARGET_DISK" set 1 esp on
parted -s "$TARGET_DISK" mkpart dialos-luks 513MiB 100%
partprobe "$TARGET_DISK"
sleep 2

if [[ "$TARGET_DISK" == *nvme* ]]; then
  ESP_PART="${TARGET_DISK}p1"
  LUKS_PART="${TARGET_DISK}p2"
else
  ESP_PART="${TARGET_DISK}1"
  LUKS_PART="${TARGET_DISK}2"
fi

mkfs.vfat -F32 -n DIALOS-ESP "$ESP_PART"

# --- 6. Prepare the key stick: format, write keyfile ---
umount "${KEY_STICK}"* 2>/dev/null || true
wipefs -af "$KEY_STICK"
parted -s "$KEY_STICK" mklabel gpt
parted -s "$KEY_STICK" mkpart "$LABEL" fat32 1MiB 100%
partprobe "$KEY_STICK"
sleep 2
KEY_STICK_PART="${KEY_STICK}1"
mkfs.vfat -F32 -n "$LABEL" "$KEY_STICK_PART"

mkdir -p /run/dialos-key-write
mount "$KEY_STICK_PART" /run/dialos-key-write
KEYFILE="/run/dialos-key-write/$KEYFILE_NAME"
head -c 512 /dev/urandom > "$KEYFILE"
sync

# --- 7. LUKS setup: keyfile as primary slot, recovery passphrase as second slot ---
cryptsetup luksFormat --type luks2 --batch-mode "$LUKS_PART" "$KEYFILE"
printf '%s' "$RECOVERY_PASS" > /tmp/.rp
cryptsetup luksAddKey --batch-mode --key-file="$KEYFILE" "$LUKS_PART" /tmp/.rp
shred -u /tmp/.rp

# --- 7b. Encrypted off-site backup of the keyfile (e.g. for upload to
#          Stephan's own Nextcloud) - lets a replacement stick be made
#          later without keeping spare physical sticks in stock. Only
#          the small keyfile is backed up, never the disk contents.
#
#          Uses a SEPARATE, randomly generated backup password - NOT the
#          recovery passphrase from step 3. Reusing the recovery password
#          would mean anyone with both that password and access to the
#          Nextcloud backup could decrypt the keyfile without ever
#          needing the physical stick, defeating the whole point of
#          stick-based unlock. Store the backup password somewhere
#          separate from the Nextcloud backup itself (e.g. Stephan's own
#          password manager) - never alongside the backup file. ---
BACKUP_LABEL=$(zenity --entry --title="Schlüssel-Backup" \
  --text="Kennzeichnung für dieses Backup (z. B. Kundenname/Kürzel):" \
  --entry-text="dialos-$(date +%Y%m%d)" 2>/dev/null || echo "dialos-$(date +%Y%m%d-%H%M%S)")
BACKUP_PASS=$(openssl rand -base64 32)
BACKUP_TMP="/tmp/${BACKUP_LABEL}.key.enc"
BACKUP_PASS_FILE=$(mktemp)
printf '%s' "$BACKUP_PASS" > "$BACKUP_PASS_FILE"
openssl enc -aes-256-cbc -pbkdf2 -salt -in "$KEYFILE" -out "$BACKUP_TMP" -pass "file:$BACKUP_PASS_FILE"
shred -u "$BACKUP_PASS_FILE"
SAVE_TO=$(zenity --file-selection --save --confirm-overwrite \
  --title="Verschlüsseltes Schlüssel-Backup speichern (z. B. im Nextcloud-Sync-Ordner)" \
  --filename="$HOME/${BACKUP_LABEL}.key.enc" 2>/dev/null || true)
if [ -n "$SAVE_TO" ]; then
  cp "$BACKUP_TMP" "$SAVE_TO"
  say "Backup gespeichert unter: $SAVE_TO\nFalls der Ordner nicht automatisch synchronisiert wird, manuell in die Nextcloud hochladen.\n\nBACKUP-PASSWORT (getrennt von der Nextcloud aufbewahren, z. B. im eigenen Passwort-Manager - NIEMALS zusammen mit der Backup-Datei!):\n$BACKUP_PASS\n\nEntschlüsselung später: openssl enc -d -aes-256-cbc -pbkdf2 -in $BACKUP_LABEL.key.enc -out neuer-stick.key"
else
  warn "Kein Speicherort gewählt - Schlüssel-Backup wurde NICHT gesichert."
fi
shred -u "$BACKUP_TMP" 2>/dev/null || rm -f "$BACKUP_TMP"

umount /run/dialos-key-write

cryptsetup open --key-file="$KEYFILE" "$LUKS_PART" "$LUKS_NAME"
mkfs.ext4 -L dialos-root "/dev/mapper/$LUKS_NAME"

# --- 8. Copy the running live system onto the new root ---
mkdir -p "$TARGET_MNT"
mount "/dev/mapper/$LUKS_NAME" "$TARGET_MNT"
mkdir -p "$TARGET_MNT/boot/efi"
mount "$ESP_PART" "$TARGET_MNT/boot/efi"

say "Kopiere das System auf die Zielfestplatte - das dauert mehrere Minuten."
rsync -aAXH --info=progress2 / "$TARGET_MNT" \
  --exclude=/dev --exclude=/proc --exclude=/sys --exclude=/tmp \
  --exclude=/run --exclude=/mnt --exclude=/media --exclude=/lost+found \
  --exclude="$TARGET_MNT"

for d in dev proc sys run; do mount --bind "/$d" "$TARGET_MNT/$d"; done

LUKS_UUID=$(cryptsetup luksUUID "$LUKS_PART")
ESP_UUID=$(blkid -s UUID -o value "$ESP_PART")
ROOT_UUID=$(blkid -s UUID -o value "/dev/mapper/$LUKS_NAME")

cat > "$TARGET_MNT/etc/crypttab" <<EOF
$LUKS_NAME UUID=$LUKS_UUID none luks,keyscript=/usr/local/sbin/dialos-keyscript,keyscript-timeout=60
EOF

cat > "$TARGET_MNT/etc/fstab" <<EOF
UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1
UUID=$ESP_UUID /boot/efi vfat umask=0077 0 1
EOF

# --- 9. Bootloader + initramfs inside the new root ---
chroot "$TARGET_MNT" apt-get update
chroot "$TARGET_MNT" apt-get install -y --no-install-recommends grub-efi-amd64 cryptsetup-initramfs
chroot "$TARGET_MNT" update-initramfs -u -k all
chroot "$TARGET_MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=dialos --removable
chroot "$TARGET_MNT" update-grub

for d in dev proc sys run; do umount "$TARGET_MNT/$d"; done
umount "$TARGET_MNT/boot/efi"
umount "$TARGET_MNT"
cryptsetup close "$LUKS_NAME"

say "Installation abgeschlossen. Sicherheits-Stick jetzt abziehen (getrennt vom Gerät versenden), Live-USB entfernen und neu starten."
