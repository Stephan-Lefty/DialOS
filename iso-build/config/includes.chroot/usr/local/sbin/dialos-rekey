#!/bin/bash
# DialOS re-key tool: issues a replacement security stick for an
# already-installed system, without needing to ship a new device.
#
# Intended flow when a stick is lost (see docs/sicherheit-datenschutz.md):
#   1. The user (or a family member/caregiver, guided by phone) types
#      the recovery passphrase once at the LUKS boot prompt, so the
#      system can boot at all.
#   2. Once booted, the user says "Hilfe rufen" to start RustDesk.
#   3. Stephan connects remotely and runs this tool: it writes a fresh
#      keyfile onto a new USB stick the user has plugged in, adds it as
#      a LUKS key, retires the old (lost) keyfile slot, and offers a
#      new encrypted backup to save into Nextcloud.
#
# Requires the CURRENT recovery passphrase as proof of authorization
# (standard LUKS behaviour: adding a key needs an existing valid key).
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  exec pkexec "$0" "$@"
fi

LABEL="DIALOS-KEY"
DATA_LABEL="DIALOS-DATA"
KEYFILE_NAME=".dialos-key"

say() { zenity --info --width=400 --title="DialOS Stick-Ersatz" --text="$1" 2>/dev/null || echo "$1"; }
warn() { zenity --warning --width=400 --title="DialOS Stick-Ersatz" --text="$1" 2>/dev/null || echo "$1" >&2; }
die() { zenity --error --width=400 --title="DialOS Stick-Ersatz" --text="$1" 2>/dev/null || echo "$1" >&2; exit 1; }
ask_password() { zenity --password --title="$1" 2>/dev/null; }

# --- 1. Find the LUKS partition backing the running system ---
LUKS_NAME=$(awk '$1 !~ /^#/ {print $1; exit}' /etc/crypttab)
LUKS_UUID=$(awk '$1 !~ /^#/ {print $2; exit}' /etc/crypttab | sed 's/UUID=//')
[ -n "$LUKS_UUID" ] || die "Kein LUKS-Eintrag in /etc/crypttab gefunden - dieses Werkzeug ist nur für ein installiertes DialOS-System gedacht."
LUKS_PART="/dev/disk/by-uuid/$LUKS_UUID"
[ -e "$LUKS_PART" ] || die "LUKS-Partition $LUKS_UUID nicht gefunden."

echo "== DialOS Stick-Ersatz =="

# --- 2. Authorize with the current recovery passphrase ---
say "Zum Anlegen eines neuen Sicherheits-Sticks wird das aktuell gültige Wiederherstellungs-Passwort benötigt."
OLD_PASS=$(ask_password "Aktuelles Wiederherstellungs-Passwort eingeben")
[ -n "$OLD_PASS" ] || die "Abgebrochen: kein Passwort eingegeben."
printf '%s' "$OLD_PASS" | cryptsetup luksOpen --test-passphrase --key-file=- "$LUKS_PART" 2>/dev/null || \
  die "Passwort wurde von LUKS nicht akzeptiert - Abbruch, kein Stick wurde verändert."

# --- 3. Select the new USB stick ---
mapfile -t USB_ROWS < <(lsblk -dnb -o NAME,SIZE,TRAN | awk '$3=="usb"')
USB_ARGS=()
for row in "${USB_ROWS[@]}"; do
  name=$(echo "$row" | awk '{print $1}')
  size=$(echo "$row" | awk '{print $2}')
  sizeh=$(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size")
  USB_ARGS+=("/dev/$name" "$sizeh")
done
if [ "${#USB_ARGS[@]}" -eq 0 ]; then
  die "Kein USB-Stick gefunden. Neuen Stick anschließen und erneut versuchen."
fi
NEW_STICK=$(zenity --list --title="Neuen Sicherheits-Stick wählen" \
  --text="Auf diesem Stick werden der Entschlüsselungs-Schlüssel (2 GiB) und ein Datenspeicher-Bereich (Rest der Kapazität) angelegt.\nDer Stick wird dabei komplett neu formatiert." \
  --column="Gerät" --column="Größe" --width=500 --height=250 \
  "${USB_ARGS[@]}")
[ -n "$NEW_STICK" ] || die "Abgebrochen: kein Stick gewählt."

NEW_STICK_SIZE=$(lsblk -dnb -o SIZE "$NEW_STICK" 2>/dev/null || echo 0)
if [ "$NEW_STICK_SIZE" -lt 2684354560 ]; then
  die "Der gewählte Stick ist zu klein (mind. ~2,5 GB nötig für Schlüssel- + Datenpartition)."
fi

CONFIRM=$(zenity --entry --title="Bestätigung" \
  --text="Stick $NEW_STICK wird GELÖSCHT und als neuer Sicherheits-Stick eingerichtet.\nZum Bestätigen \"LOESCHEN\" eingeben:" 2>/dev/null || true)
[ "$CONFIRM" = "LOESCHEN" ] || die "Abgebrochen: Bestätigung nicht erhalten."

# --- 4. Format the stick (DIALOS-KEY 2 GiB + DIALOS-DATA rest) and
#          write a fresh keyfile ---
umount "${NEW_STICK}"* 2>/dev/null || true
wipefs -af "$NEW_STICK"
parted -s "$NEW_STICK" mklabel gpt
parted -s "$NEW_STICK" mkpart "$LABEL" fat32 1MiB 2049MiB
parted -s "$NEW_STICK" mkpart "$DATA_LABEL" ext4 2049MiB 100%
partprobe "$NEW_STICK"
sleep 2
NEW_STICK_PART="${NEW_STICK}1"
NEW_DATA_PART="${NEW_STICK}2"
mkfs.vfat -F32 -n "$LABEL" "$NEW_STICK_PART"
mkfs.ext4 -F -L "$DATA_LABEL" "$NEW_DATA_PART"

mkdir -p /run/dialos-rekey
mount "$NEW_STICK_PART" /run/dialos-rekey
NEW_KEYFILE="/run/dialos-rekey/$KEYFILE_NAME"
head -c 512 /dev/urandom > "$NEW_KEYFILE"
sync

# --- 5. Add the new keyfile as a LUKS key, retire the old one ---
printf '%s' "$OLD_PASS" | cryptsetup luksAddKey --batch-mode --key-file=- "$LUKS_PART" "$NEW_KEYFILE"
OLD_SLOT=$(cryptsetup luksDump "$LUKS_PART" | awk '/Keyslots:/{f=1;next} f && /luks2/{print $1; exit}' | tr -d ':')
if [ -n "${OLD_SLOT:-}" ]; then
  cryptsetup luksKillSlot --batch-mode --key-file=- "$LUKS_PART" "$OLD_SLOT" <<< "$OLD_PASS" 2>/dev/null || \
    warn "Der alte Schlüssel-Slot (verlorener Stick) konnte nicht automatisch entfernt werden - bitte manuell mit 'cryptsetup luksKillSlot' prüfen."
fi

# --- 6. New recovery passphrase + new encrypted Nextcloud backup ---
say "Jetzt wird ein neues Wiederherstellungs-Passwort festgelegt (ersetzt das alte). Mindestens 12 Zeichen."
NEW_PASS=""
while [ -z "$NEW_PASS" ] || [ "${#NEW_PASS}" -lt 12 ]; do
  NEW_PASS=$(ask_password "Neues Wiederherstellungs-Passwort festlegen (mind. 12 Zeichen)")
  if [ -z "$NEW_PASS" ]; then
    warn "Passwort darf nicht leer sein."
  elif [ "${#NEW_PASS}" -lt 12 ]; then
    warn "Passwort ist zu kurz (mind. 12 Zeichen)."
    NEW_PASS=""
  fi
done
printf '%s' "$OLD_PASS" | cryptsetup luksChangeKey --batch-mode --key-file=- "$LUKS_PART" <<< "$NEW_PASS" 2>/dev/null || \
  warn "Altes Wiederherstellungs-Passwort konnte nicht automatisch ersetzt werden - beide Passwörter könnten jetzt gültig sein, bitte manuell prüfen."

# Backup password is a SEPARATE, randomly generated secret - NOT
# NEW_PASS. See the equivalent comment in dialos-install step 7b for
# why reusing the recovery passphrase here would be a security hole.
BACKUP_LABEL=$(zenity --entry --title="Schlüssel-Backup" \
  --text="Kennzeichnung für dieses Backup (z. B. Kundenname/Kürzel):" \
  --entry-text="dialos-rekey-$(date +%Y%m%d)" 2>/dev/null || echo "dialos-rekey-$(date +%Y%m%d-%H%M%S)")
BACKUP_PASS=$(openssl rand -base64 32)
BACKUP_TMP="/tmp/${BACKUP_LABEL}.key.enc"
BACKUP_PASS_FILE=$(mktemp)
printf '%s' "$BACKUP_PASS" > "$BACKUP_PASS_FILE"
openssl enc -aes-256-cbc -pbkdf2 -salt -in "$NEW_KEYFILE" -out "$BACKUP_TMP" -pass "file:$BACKUP_PASS_FILE"
shred -u "$BACKUP_PASS_FILE"
SAVE_TO=$(zenity --file-selection --save --confirm-overwrite \
  --title="Neues verschlüsseltes Schlüssel-Backup speichern (z. B. im Nextcloud-Sync-Ordner)" \
  --filename="$HOME/${BACKUP_LABEL}.key.enc" 2>/dev/null || true)
if [ -n "$SAVE_TO" ]; then
  cp "$BACKUP_TMP" "$SAVE_TO"
  say "Backup gespeichert unter: $SAVE_TO - bitte das alte Backup dieses Nutzers in der Nextcloud löschen/ersetzen.\n\nBACKUP-PASSWORT (getrennt von der Nextcloud aufbewahren, z. B. im eigenen Passwort-Manager - NIEMALS zusammen mit der Backup-Datei!):\n$BACKUP_PASS"
else
  warn "Kein Speicherort gewählt - neues Schlüssel-Backup wurde NICHT gesichert."
fi
shred -u "$BACKUP_TMP" 2>/dev/null || rm -f "$BACKUP_TMP"

umount /run/dialos-rekey

say "Fertig. Neuer Stick ist einsatzbereit, alter Stick ist als Schlüssel ungültig. Gerät kann jetzt normal mit dem neuen Stick neu gestartet werden."
