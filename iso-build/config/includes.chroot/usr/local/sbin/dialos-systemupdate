#!/bin/bash
# DialOS: Systemaktualisierung - der Teil, der root braucht.
#
# Stephans Vorgabe vom 2026-09-14: "Irgendwann haben wir ja DialOS fertig und
# dann sollten auch immer die Pakete, die wir fuer einen reibungslosen Lauf von
# DialOS benoetigen, auf dem aktuellen Stand sein." Alle 14 Tage, montags beim
# ersten Start, mit Ansage und Neustart.
#
# WARUM UEBERHAUPT ZWEI SKRIPTE. Dieses hier laeuft als root und tut nur die
# drei Dinge, die root brauchen. Die Entscheidung, die Ansagen und das Zuhoeren
# liegen in dialos-update-lauf.py, das OHNE root laeuft. Dieselbe Aufteilung
# wie bei dialos-aufspielen und dialos-stimme-wechseln: Was ueber sudo geht,
# soll so klein und so woertlich sein wie moeglich.
#
# DREI FESTE AKTIONEN, KEINE ARGUMENTE DARUEBER HINAUS. Die sudoers-Regel
# nennt sie einzeln und woertlich. Ein "dialos-systemupdate *" waere praktisch
# ein Root-Zugang.
#
# Aufruf:
#   dialos-systemupdate pruefen       "<pakete> <firmware>" - wie viel ist offen?
#   dialos-systemupdate installieren  apt update + apt upgrade, dann Firmware
#   dialos-systemupdate neustarten    Neustart - NUR mit Sicherheits-Stick
set -uo pipefail

PROTOKOLL="/var/log/dialos-systemupdate.log"
STICK_LABEL="DIALOS-KEY"
ZULETZT="/var/lib/dialos/systemupdate-zuletzt"
# Liegt unter /run, und das ist der ganze Trick: /run ist ein tmpfs und ist nach
# jedem Hochfahren leer. Existiert die Datei, wurde SEIT DEM LETZTEN START ein
# Update installiert. Unabhaengig von der Uhr, und nur root kann sie anlegen.
IN_DIESEM_START="/run/dialos-systemupdate-installiert"

melde() {
    mkdir -p "$(dirname "$PROTOKOLL")" 2>/dev/null
    echo "$(date '+%m-%d %H:%M:%S')  $1" >> "$PROTOKOLL"
}

# ------------------------------------------------------------ Firmware ---
# FIRMWARE GEHOERT SEIT 2026-09-14 DAZU (Stephans Wahl: "In die
# 14-Tage-Automatik, nur am Netzteil"). Anlass: GNOME-Software zeigte eine
# Firmware-Aktualisierung (UEFI dbx), die dieses Skript nie gesehen hat - apt
# kennt keine Firmware, die kommt ueber fwupd/LVFS.
#
# NUR AM NETZTEIL UND MIT MINDESTENS 50 % AKKU. Ein BIOS-Update wird beim
# Neustart eingespielt; faellt dabei der Strom aus, kann das Geraet unbrauchbar
# werden - und ein blinder Nutzer merkt nicht, dass gerade eines laeuft. Gilt
# die Bedingung nicht, wird Firmware weder gezaehlt noch eingespielt, sondern
# beim naechsten Lauf wieder angefasst.
#
# Nur "Mains" zaehlt als Netzteil, nicht die USB-C-Anschluesse: Die melden auch
# ein angeschlossenes Geraet, das selbst Strom zieht. Lieber einmal zu
# vorsichtig als einmal mitten im Flashen ohne Strom.
FIRMWARE_AKKU_MIN=50

am_netz() {
    local netz=0 d
    for d in /sys/class/power_supply/*; do
        [ "$(cat "$d/type" 2>/dev/null)" = "Mains" ] || continue
        [ "$(cat "$d/online" 2>/dev/null)" = "1" ] && netz=1
    done
    [ "$netz" = "1" ] || return 1
    for d in /sys/class/power_supply/*; do
        [ "$(cat "$d/type" 2>/dev/null)" = "Battery" ] || continue
        [ "$(cat "$d/capacity" 2>/dev/null || echo 0)" -ge "$FIRMWARE_AKKU_MIN" ] || return 1
    done
    return 0
}

firmware_offen() {
    command -v fwupdmgr >/dev/null 2>&1 || { echo 0; return; }
    am_netz || { echo 0; return; }
    fwupdmgr get-updates --json --no-unreported-check 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print(0); sys.exit()
print(sum(1 for g in d.get("Devices", []) if g.get("Releases")))
' 2>/dev/null || echo 0
}

# --------------------------------------------------------------- pruefen ---
pakete_offen() {
    # Ohne "apt update": Die Frage ist, was mit dem VORHANDENEN Index offen
    # waere. Ein Index-Abruf gehoert zum Installieren, nicht zum Nachsehen -
    # sonst braucht schon das blosse Fragen Netz und Zeit.
    apt list --upgradable 2>/dev/null | tail -n +2 | wc -l
}

pruefen() {
    echo "$(pakete_offen) $(firmware_offen)"
}

# ---------------------------------------------------------- installieren ---
installieren() {
    melde "=== Installieren angefordert ==="

    export DEBIAN_FRONTEND=noninteractive

    if ! apt-get update >>"$PROTOKOLL" 2>&1; then
        melde "apt update fehlgeschlagen - nichts installiert"
        return 1
    fi

    local vorher firmware eingespielt=0
    vorher="$(pakete_offen)"
    firmware="$(firmware_offen)"
    melde "offen vor dem Lauf: $vorher Paket(e), $firmware Firmware"
    if [ "$vorher" -eq 0 ] && [ "$firmware" -eq 0 ]; then
        melde "nichts zu tun"
        datum_merken
        return 0
    fi
    if [ "$vorher" -eq 0 ]; then
        firmware_einspielen || return 1
        datum_merken
        installiert_merken
        return 0
    fi

    # KEIN "dist-upgrade" UND KEIN "autoremove", und beides mit Absicht:
    #
    # "upgrade" installiert nur, was sich ohne Entfernen aktualisieren laesst.
    # "dist-upgrade" darf Pakete ENTFERNEN, um Abhaengigkeiten aufzuloesen -
    # unbeaufsichtigt, auf einem Geraet, das ein blinder Nutzer allein bedient.
    #
    # "autoremove" waere noch schlimmer. Gemessen am 2026-08-19: Sobald
    # dialos-aufraeumen.sh einen GNOME-Bestandteil entfernt hat, gelten 49
    # Pakete als "automatisch installiert", darunter gnome-shell und
    # pipewire-audio. Ein autoremove wuerde also anbieten, Desktop und
    # Ton-Unterbau zu entfernen. Steht so auch in
    # /etc/apt/apt.conf.d/52dialos-unattended-upgrades, und dort heisst es
    # ausdruecklich "die wichtigste Zeile in dieser Datei".
    #
    # -o Dpkg::Options: bestehende Konfigurationsdateien behalten. Ohne das
    # bleibt apt bei einer geaenderten Datei mit einer Rueckfrage stehen, die
    # niemand beantworten kann - und der Lauf haengt bis zur Zeitgrenze.
    if apt-get -y \
            -o Dpkg::Options::="--force-confdef" \
            -o Dpkg::Options::="--force-confold" \
            upgrade >>"$PROTOKOLL" 2>&1; then
        local nachher
        nachher="$(pakete_offen)"
        melde "fertig - vorher $vorher, jetzt noch $nachher offen"
        # Firmware NACH den Paketen: Ein neues fwupd aus dem Paketlauf soll
        # schon das sein, das die Firmware einspielt. Scheitert die Firmware,
        # sind die Pakete trotzdem drin - das zaehlt als Installation.
        firmware_einspielen || melde "Firmware nicht eingespielt - naechster Lauf"
        datum_merken
        installiert_merken
        return 0
    fi

    melde "apt upgrade fehlgeschlagen"
    return 1
}

firmware_einspielen() {
    local offen
    # Die Bedingung wird HIER noch einmal geprueft, unmittelbar vor dem
    # Einspielen - zwischen "pruefen" und diesem Moment kann jemand das
    # Netzteil gezogen haben. Derselbe Gedanke wie bei der Stick-Pruefung.
    if ! am_netz; then
        melde "Firmware uebersprungen - kein Netzteil oder Akku unter ${FIRMWARE_AKKU_MIN} %"
        return 0
    fi
    offen="$(firmware_offen)"
    [ "$offen" -gt 0 ] || return 0
    melde "Firmware: $offen Geraet(e)"
    if fwupdmgr update --assume-yes --no-reboot-check --no-unreported-check >>"$PROTOKOLL" 2>&1; then
        melde "Firmware eingespielt (wird ggf. beim Neustart wirksam)"
        return 0
    fi
    melde "Firmware-Aktualisierung fehlgeschlagen"
    return 1
}

# DIE MELDUNG FUER DIE BEGRUESSUNG GEHOERT DEM RECHNER (Fehler vom 2026-09-14).
# Nur nach einer ECHTEN Installation - im Zweig "nichts zu tun" wird sie nicht
# geschrieben, sonst hoerte jede Person alle vierzehn Tage "auf dem neuesten
# Stand", obwohl nichts passiert ist. Die Start-Ansage jeder Person vergleicht
# den Zeitstempel mit dem, was sie schon gemeldet hat; Begruendung dort.
INSTALLIERT="/var/lib/dialos/systemupdate-installiert"
installiert_merken() {
    mkdir -p "$(dirname "$INSTALLIERT")" 2>/dev/null
    date '+%Y-%m-%dT%H:%M:%S' > "$INSTALLIERT"
    chmod 0644 "$INSTALLIERT"
    touch "$IN_DIESEM_START"
}

datum_merken() {
    mkdir -p "$(dirname "$ZULETZT")" 2>/dev/null
    date '+%Y-%m-%d' > "$ZULETZT"
    chmod 0644 "$ZULETZT"
}

# ------------------------------------------------------------ neustarten ---
neustarten() {
    # NEUSTART NUR NACH EINEM ECHTEN UPDATE IN DIESEM START (Stephans Freigabe
    # vom 2026-09-14, bei der Durchsicht der sudoers-Regel). Ohne diese
    # Bedingung koennte jedes Programm, das unter nutzer oder dialosadmin
    # laeuft, den Rechner ohne Passwort neu starten, sobald der Stick steckt -
    # auch immer wieder. Jetzt muss vorher wirklich etwas installiert worden
    # sein, und das geht nur, wenn Pakete offen sind.
    #
    # Nebenbei ist damit eine Neustart-Schleife an der Stelle ausgeschlossen,
    # die root hat: Nach dem Neustart ist /run leer, ein zweiter Neustart wird
    # abgelehnt. Vorher verhinderte das nur die Faelligkeitsrechnung im
    # Programm ohne root.
    if [ ! -e "$IN_DIESEM_START" ]; then
        melde "Neustart ABGELEHNT - seit dem letzten Start kein Update installiert"
        echo "kein-update"
        return 3
    fi

    # DIE PRUEFUNG STEHT HIER UND NICHT BEIM AUFRUFER, und das ist der
    # wichtigste Satz in dieser Datei.
    #
    # dialos-stick-gate sperrt das Konto "nutzer" mit "usermod -L", wenn der
    # Sicherheits-Stick beim Booten fehlt - sonst liefe die Sitzung gegen ein
    # Verzeichnis auf der UNVERSCHLUESSELTEN root-Partition. Ein Neustart ohne
    # Stick sperrt den Nutzer also aus seinem eigenen Geraet aus, und er kann
    # nicht nachsehen, warum. Genau deshalb steht in der
    # unattended-upgrades-Konfiguration "Automatic-Reboot false".
    #
    # Dem Aufrufer zu vertrauen waere hier falsch: Ein Fehler dort - eine
    # vertauschte Bedingung, ein nicht abgefangener Ausnahmefall - kostet den
    # Nutzer den Zugang zu seinen Daten. Die Pruefung gehoert an die Stelle,
    # die den Neustart wirklich ausloest.
    udevadm settle --timeout=2 >/dev/null 2>&1 || true
    if ! blkid -L "$STICK_LABEL" >/dev/null 2>&1; then
        melde "Neustart ABGELEHNT - kein Sicherheits-Stick ($STICK_LABEL)"
        echo "kein-stick"
        return 2
    fi
    melde "Neustart - Sicherheits-Stick vorhanden"
    # Kurzer Vorlauf, damit die Ansage des Aufrufers noch zu Ende gesprochen
    # wird. "systemctl reboot" wuerde sie mitten im Satz abschneiden.
    sleep 4
    systemctl reboot
}

case "${1:-}" in
    pruefen)      pruefen ;;
    installieren) installieren ;;
    neustarten)   neustarten ;;
    *)
        echo "Aufruf: $0 pruefen|installieren|neustarten" >&2
        exit 1
        ;;
esac
