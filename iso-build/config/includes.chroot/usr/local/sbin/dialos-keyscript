#!/bin/sh
# LUKS keyscript for DialOS: unlocks the root partition using a
# keyfile stored on a dedicated USB stick, instead of a typed password.
# Referenced from /etc/crypttab as:
#   dialos-root UUID=... none luks,keyscript=/usr/local/sbin/dialos-keyscript,keyscript-timeout=60
#
# See docs/sicherheit-datenschutz.md for the reasoning: the target group
# cannot reliably type a passphrase blind, so unlocking is tied to
# physical possession of a labeled USB stick instead.

set -e

LABEL="DIALOS-KEY"
KEYFILE_NAME=".dialos-key"
MOUNTPOINT="/run/dialos-key-mount"
TIMEOUT=60

mkdir -p "$MOUNTPOINT"

i=0
DEVICE=""
while [ "$i" -lt "$TIMEOUT" ]; do
  if [ -e "/dev/disk/by-label/$LABEL" ]; then
    DEVICE="/dev/disk/by-label/$LABEL"
    break
  fi
  udevadm settle --timeout=1 2>/dev/null || true
  sleep 1
  i=$((i + 1))
done

if [ -z "$DEVICE" ]; then
  # No stick found in time - fail so cryptsetup falls back to asking
  # for a passphrase interactively (the recovery slot).
  exit 1
fi

mount -o ro "$DEVICE" "$MOUNTPOINT" 2>/dev/null || exit 1
if [ -f "$MOUNTPOINT/$KEYFILE_NAME" ]; then
  cat "$MOUNTPOINT/$KEYFILE_NAME"
fi
umount "$MOUNTPOINT" 2>/dev/null || true

exit 0
