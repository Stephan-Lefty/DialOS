#!/bin/sh
set -e

USERNAME=nutzer

echo "[dialos] Creating default desktop user '$USERNAME'..."
adduser --disabled-password --gecos "" "$USERNAME"
usermod -aG sudo,audio,video,plugdev,netdev,bluetooth,scanner,lpadmin,cdrom "$USERNAME"

# Random password per build, only relevant for sudo/admin access - the
# end user never types anything (autologin handles session login).
# Generated fresh each build instead of a fixed value, and printed to
# the build log only (never committed). How sudo should ultimately work
# for the voice-guided maintenance flow is still an open decision, see
# docs/sicherheit-datenschutz.md.
GEN_PASSWORD=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16)
echo "$USERNAME:$GEN_PASSWORD" | chpasswd
echo "[dialos] Generated sudo password for '$USERNAME': $GEN_PASSWORD"
