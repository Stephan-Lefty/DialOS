#!/bin/sh
set -e

echo "[dialos] Installing RustDesk..."
cd /tmp

DEB_URL=$(curl -fsSL https://api.github.com/repos/rustdesk/rustdesk/releases/latest \
  | grep -oE '"browser_download_url": *"[^"]*x86_64\.deb"' \
  | head -n1 \
  | sed -E 's/"browser_download_url": *"([^"]*)"/\1/')

if [ -z "$DEB_URL" ]; then
  echo "[dialos] WARNING: could not determine RustDesk download URL, skipping." >&2
  exit 0
fi

echo "[dialos] Downloading $DEB_URL"
curl -fsSL -o rustdesk.deb "$DEB_URL"
apt-get update
# RustDesk's postinst tries to register a setuid input-simulation
# helper via PolicyKit, which fails in this build chroot (no real
# polkit/systemd session running) - harmless here, it self-configures
# on the actual target machine's first real boot. Don't let it abort
# the whole image build.
dpkg -i rustdesk.deb || apt-get install -f -y || true
rm -f rustdesk.deb
echo "[dialos] RustDesk install step finished (see above for any non-fatal warnings)."
