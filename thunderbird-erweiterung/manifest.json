{
  "manifest_version": 2,
  "name": "DialOS-Brücke",
  "version": "0.1.6",
  "description": "Legt Entwürfe ab und trägt Kontakte ein - für die Sprachsteuerung DialOS.",
  "applications": {
    "gecko": {
      "id": "bruecke@dialos.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "addressBooks",
    "compose",
    "compose.save",
    "compose.send",
    "messagesRead",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "hintergrund.js"
    ]
  }
}
