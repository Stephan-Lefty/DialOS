# Vorlage – kopieren nach .env und ausfüllen. Die .env ist per .gitignore
# ausgeschlossen und darf NICHT ins Repo (github.com/Stephan-Lefty/DialOS ist öffentlich).

WP_URL=https://dialos.org
WP_USER=ClaudIA

# Application Password aus WordPress (Benutzer -> Profil -> Application Passwords).
# Wird mit Leerzeichen angezeigt, z. B. "abcd EFGH 1234 ijkl MNOP 5678" –
# die Leerzeichen dürfen drin bleiben (WordPress ignoriert sie), müssen hier
# aber wegen der Leerzeichen in Anführungszeichen stehen.
WP_APP_PASSWORD=""
